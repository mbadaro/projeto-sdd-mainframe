//PSDDE001 PROC HLQ=SDD
//*-------------------------------------------------------------------
//* PSDDE001 - PROCESSAMENTO BATCH DE PAGAMENTOS
//* EXECUCAO EVENTUAL (SOB DEMANDA) - DOCUMENTACAO: DSDDE001
//* PROGRAMA: SDDP0001
//* RC 0 = SEM REJEITADOS / 4 = COM REJEITADOS / 12 = ERRO ARQUIVO
//*-------------------------------------------------------------------
//STEP01   EXEC PGM=SDDP0001
//STEPLIB  DD DSN=&HLQ..LOADLIB,DISP=SHR
//*        ENTRADA: PAGAMENTOS A PROCESSAR (FB 30)
//PAGENT   DD DSN=&HLQ..PAGAMENT.ENTRADA,DISP=SHR
//*        SAIDA: PAGAMENTOS APROVADOS (FB 30)
//PAGAPR   DD DSN=&HLQ..PAGAMENT.APROVADO,
//            DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSDA,SPACE=(TRK,(5,5),RLSE),
//            DCB=(RECFM=FB,LRECL=30,BLKSIZE=0)
//*        SAIDA: PAGAMENTOS REJEITADOS + MOTIVO (FB 32)
//PAGREJ   DD DSN=&HLQ..PAGAMENT.REJEITAD,
//            DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSDA,SPACE=(TRK,(5,5),RLSE),
//            DCB=(RECFM=FB,LRECL=32,BLKSIZE=0)
//*        MENSAGENS E CONTADORES
//SYSOUT   DD SYSOUT=*
//         PEND
